local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0, 750, 0, 50)
frame.Position = UDim2.new(0.5, -375, 0.9, -60)
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)

local layout = Instance.new("UIListLayout", frame)
layout.FillDirection = Enum.FillDirection.Horizontal
layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
layout.Padding = UDim.new(0, 5)

-- ปุ่ม Toggle GUI
local toggleBtn = Instance.new("TextButton", gui)
toggleBtn.Size = UDim2.new(0, 40, 0, 40)
toggleBtn.Position = UDim2.new(0, 10, 0.5, -20)
toggleBtn.BackgroundColor3 = Color3.fromRGB(128, 0, 128)
toggleBtn.Text = "GUI"
toggleBtn.TextColor3 = Color3.new(1, 1, 1)
toggleBtn.Draggable = true
toggleBtn.MouseButton1Click:Connect(function() frame.Visible = not frame.Visible end)

-- ฟังก์ชันสร้างปุ่ม
local function addButton(text, color, func)
	local btn = Instance.new("TextButton", frame)
	btn.Size = UDim2.new(0, 70, 0, 40)
	btn.BackgroundColor3 = color
	btn.Text = text
	btn.MouseButton1Click:Connect(func)
end

-- ปุ่มต่างๆ
addButton("Jump", Color3.fromRGB(180, 50, 50), function() states.infiniteJump = not states.infiniteJump end)
addButton("Fly", Color3.fromRGB(180, 50, 50), function() if states.flying then stopFlying() else startFlying() end end)
addButton("Noclip", Color3.fromRGB(180, 50, 50), function() states.noclip = not states.noclip end)
addButton("God", Color3.fromRGB(180, 50, 50), function() states.godMode = not states.godMode end)
addButton("Knock", Color3.fromRGB(200, 150, 50), function() states.knockback = not states.knockback end) -- ปุ่ม Knockback

-- ช่องใส่ความเร็ว
local function addBox(placeholder, speedType)
	local box = Instance.new("TextBox", frame)
	box.Size = UDim2.new(0, 70, 0, 40)
	box.PlaceholderText = placeholder
	box.FocusLost:Connect(function()
		local val = tonumber(box.Text)
		if val then 
			if speedType == "fly" then states.flySpeed = math.clamp(val, 1, 1000)
			else states.walkSpeed = math.clamp(val, 1, 1000) humanoid.WalkSpeed = states.walkSpeed end
		end
	end)
end

addBox("FlySpd", "fly")
addBox("WalkSpd", "walk")

-- Waypoints
addButton("Set/Res", Color3.fromRGB(70, 130, 180), function() if rootPart then states.savedCFrame = rootPart.CFrame humanoid.Health = 0 end end)
addButton("TP", Color3.fromRGB(140, 70, 180), function() if states.savedCFrame and rootPart then rootPart.CFrame = states.savedCFrame end end)
