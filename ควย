local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")

-- ตัวแปรสถานะ
local states = {
	infiniteJump = false,
	flying = false,
	noclip = false,
	godMode = false,
	knockback = false, -- เพิ่มสถานะ Knockback
	flySpeed = 50,
	walkSpeed = 16,
	savedCFrame = nil
}

-- ฟังก์ชันจัดการ Knockback
local function onTouch(hit)
	if not states.knockback then return end
	local targetChar = hit.Parent
	local targetHumanoid = targetChar:FindFirstChild("Humanoid")
	local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")

	if targetHumanoid and targetRoot and targetChar ~= character then
		-- สร้างแรงผลัก
		local bodyVelocity = Instance.new("BodyVelocity")
		bodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
		-- คำนวณทิศทางผลัก (ออกจากตัวเรา)
		local pushDir = (targetRoot.Position - rootPart.Position).Unit
		bodyVelocity.Velocity = (pushDir + Vector3.new(0, 0.5, 0)) * 70 -- แรงผลัก 70
		bodyVelocity.Parent = targetRoot
		Debris:AddItem(bodyVelocity, 0.3) -- แรงอยู่แค่ 0.3 วินาที
	end
end

-- ฟังชันอัปเดตตัวละคร
local function setupCharacter(char)
	character = char
	humanoid = char:WaitForChild("Humanoid")
	rootPart = char:WaitForChild("HumanoidRootPart")
	humanoid.WalkSpeed = states.walkSpeed
	
	-- เชื่อมต่อระบบแตะ (Touch) กับทุกส่วนของตัวละคร
	for _, part in pairs(character:GetChildren()) do
		if part:IsA("BasePart") then
			part.Touched:Connect(onTouch)
		end
	end
end

player.CharacterAdded:Connect(setupCharacter)
setupCharacter(character) -- เรียกใช้ครั้งแรก

-- [ระบบเดิม: Jump, GodMode, Noclip, Fly เหมือนเดิม]
UserInputService.JumpRequest:Connect(function()
	if states.infiniteJump and humanoid then humanoid:ChangeState(Enum.HumanoidStateType.Jumping) end
end)

RunService.Heartbeat:Connect(function()
	if states.godMode and humanoid and humanoid.Health < humanoid.MaxHealth then humanoid.Health = humanoid.MaxHealth end
end)

RunService.Stepped:Connect(function()
	if states.noclip and character then
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") and part.CanCollide then part.CanCollide = false end
		end
	end
end)

-- ระบบบิน (คงเดิม)
local bodyVelocity, bodyGyro
local function startFlying()
	if states.flying or not rootPart then return end
	states.flying = true
	bodyVelocity = Instance.new("BodyVelocity", rootPart)
	bodyVelocity.MaxForce = Vector3.new(1e8, 1e8, 1e8)
	bodyGyro = Instance.new("BodyGyro", rootPart)
	bodyGyro.MaxTorque = Vector3.new(1e8, 1e8, 1e8)
	humanoid.PlatformStand = true
	task.spawn(function()
		while states.flying and character and rootPart do
			local camera = workspace.CurrentCamera
			local move = Vector3.zero
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += camera.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then move -= camera.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then move -= camera.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += camera.CFrame.RightVector end
			bodyVelocity.Velocity = (move.Magnitude > 0 and move.Unit or Vector3.zero) * states.flySpeed
			bodyGyro.CFrame = camera.CFrame
			RunService.RenderStepped:Wait()
		end
	end)
end

local function stopFlying()
	states.flying = false
	if humanoid then humanoid.PlatformStand = false end
	if bodyVelocity then bodyVelocity:Destroy() end
	if bodyGyro then bodyGyro:Destroy() end
end

-- สร้าง GUI
