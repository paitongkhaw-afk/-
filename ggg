		local pushButton =
			button("Push Nearby Players")

		pushButton.MouseButton1Click:Connect(function()

			local char = player.Character

			local root =
				char and
				char:FindFirstChild("HumanoidRootPart")

			if not root then
				return
			end

			local power =
				player:GetAttribute("PushPower")
				or 100

			for _,target in ipairs(
				Players:GetPlayers()
			) do

				if target ~= player then

					local tc =
						target.Character

					local tr =
						tc and
						tc:FindFirstChild(
							"HumanoidRootPart"
						)

					if tr then

						local distance =
							(root.Position -
							tr.Position).Magnitude

						if distance <= 7 then

							local direction =
								(tr.Position -
								root.Position)

							if direction.Magnitude > 0 then

								direction =
									direction.Unit

							else

								direction =
									root.CFrame.LookVector

							end

							tr.AssemblyLinearVelocity =
								direction * power +
								Vector3.new(
									0,
									power * .5,
									0
								)

						end
					end
				end
			end
		end)

