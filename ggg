--------------------------------------------------
-- REMOTE SECURITY
--------------------------------------------------

Remote.OnServerEvent:Connect(function(player, action, value)

	if not isAdmin(player) then
		return
	end

	local character =
		player.Character

	local hum =
		character and
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	if not hum then
		return
	end

	if action == "Speed" then

		hum.WalkSpeed =
			math.clamp(
				tonumber(value) or 16,
				16,
				150
			)

	elseif action == "Jump" then

		hum.UseJumpPower = true

		hum.JumpPower =
			math.clamp(
				tonumber(value) or 50,
				50,
				200
			)

	elseif action == "GodMode" then

		player:SetAttribute(
			"GodMode",
			value == true
		)

		if value then

			hum.MaxHealth =
				math.huge

			hum.Health =
				math.huge

		else

			hum.MaxHealth = 100
			hum.Health = 100

		end

	end
end)
